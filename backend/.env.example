DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173

# Configure these to use MySQL. Without MYSQL_DATABASE, development uses SQLite.
MYSQL_DATABASE=shopping_store
MYSQL_USER=shopping_app
MYSQL_PASSWORD=replace-this-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
